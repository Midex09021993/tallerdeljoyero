{
  "version": 1,
  "sdk_version": "3.6.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ynetgjhghfhvyinwvqkl.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "tallerdeljoyero",
      "version": "0.1.0",
      "title": "tallerdeljoyero"
    },
    "tools": [
      {
        "name": "listar_pedidos",
        "title": "Listar pedidos",
        "description": "Lista los pedidos del taller que el usuario puede ver, por defecto solo los activos (no entregados).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "estado": {
              "description": "Filtra por estado oficial del pedido.",
              "type": "string",
              "enum": [
                "Recibido",
                "En Producción",
                "Listo para Entrega",
                "En Camino",
                "Entregado"
              ]
            },
            "busqueda": {
              "description": "Texto a buscar en referencia, cliente, pieza o trabajo.",
              "type": "string",
              "maxLength": 80
            },
            "incluir_entregados": {
              "description": "Incluye pedidos ya entregados (histórico). Por defecto false.",
              "type": "boolean"
            },
            "limite": {
              "description": "Máximo de pedidos a devolver (1-100, por defecto 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "ver_pedido",
        "title": "Ver pedido",
        "description": "Muestra el detalle de un pedido por su id o su referencia (sin costes ni notas internas).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "description": "Id del pedido (devuelto por listar_pedidos).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "referencia": {
              "description": "Referencia visible del pedido, por ejemplo PED-0001.",
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "resumen_produccion",
        "title": "Resumen de producción",
        "description": "Cuenta los pedidos activos por estado y por área de producción, e indica cuántos están atrasados.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "listar_contratos",
        "title": "Listar contratos",
        "description": "Lista los contratos del taller con el número de pedidos que contiene cada uno.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "busqueda": {
              "description": "Texto a buscar en el número de contrato o el cliente.",
              "type": "string",
              "maxLength": 80
            },
            "limite": {
              "description": "Máximo de contratos (1-50, por defecto 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "buscar_clientes",
        "title": "Buscar clientes",
        "description": "Busca clientes del taller por nombre, ciudad, teléfono o correo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "busqueda": {
              "description": "Texto a buscar. Vacío lista los clientes más recientes.",
              "type": "string",
              "maxLength": 80
            },
            "limite": {
              "description": "Máximo de clientes (1-50, por defecto 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
